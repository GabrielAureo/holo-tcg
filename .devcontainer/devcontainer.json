{
  "name": "Holo TCG",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [4173],
  "portsAttributes": {
    "4173": {
      "label": "Holo Studio",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "npm ci --include=dev",
  "postStartCommand": "npm ci --include=dev && nohup npm run dev > /tmp/holo-studio.log 2>&1 &"
}
